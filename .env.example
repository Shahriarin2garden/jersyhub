# Database (Neon PostgreSQL - free tier)
DATABASE_URL="postgresql://<user>:<password>@<project>.region.neon.tech/neondb?sslmode=require"
# Migrations connect direct, never through PgBouncer. Locally the connection
# is already direct, so this is the same value.
DIRECT_URL="postgresql://<user>:<password>@<project>.region.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Cloudinary (free tier - 25 credits/month)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Fixed single admin account. There is only ONE admin — the seed upserts this
# and deletes any other admin row. Change here, then run `npm run db:seed`.
ADMIN_EMAIL="admin@nexvive.com"
ADMIN_PASSWORD="change-this-strong-password"

# SMS / OTP provider — customer login sends a 6-digit code to a BD phone.
# Leave ALL blank in dev: the code is returned in the app so login is testable.
# Option A — Twilio (global, incl. Bangladesh; free trial credit):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""            # e.g. +1XXXXXXXXXX (your Twilio number)
# Option B — Bangladesh SMS gateway (bulksmsbd.net / sms.net.bd style HTTP API):
SMS_API_URL=""           # e.g. http://bulksmsbd.net/api/smsapi
SMS_API_KEY=""
SMS_SENDER_ID=""

# Email (Resend - free tier). Blank = dev logs to console.
RESEND_API_KEY=""
EMAIL_FROM="NexVive <onboarding@resend.dev>"

# Public origin of the deployed site — used for absolute URLs in robots.txt and
# sitemap.xml. Falls back to NEXTAUTH_URL, then localhost, so it is optional.
NEXT_PUBLIC_SITE_URL=""
