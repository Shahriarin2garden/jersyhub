# ---------------------------------------------------------------------------
# PRODUCTION environment — NexVive
#
# Copy to `.env.netlify` (gitignored), fill every value, then load it into
# the host in one go:
#
#     netlify env:import .env.netlify
#
# Every value below must be NEW. Nothing from `.env` — the development file has
# been on a laptop, in shell history, and next to a git repository. Reusing a
# development secret in production is the most common way a small shop's admin
# panel ends up public.
#
# `src/lib/env.ts` checks the required ones at startup and refuses to serve if
# any are missing, so a typo here fails loudly at deploy time rather than
# quietly at checkout.
# ---------------------------------------------------------------------------


# --- Database ---------------------------------------------------------------
# Neon, region ap-southeast-1 (Singapore) — the closest to Bangladesh.
# Use the POOLED host: it contains `-pooler`. Serverless functions open a
# connection per invocation and will exhaust a direct Postgres connection
# limit. The two query params are required by Prisma when going through
# PgBouncer.
# Also set the compute autoscale range to 0.25–0.5 CU in the Neon console;
# the 2 CU default burns the free 100 CU-hours about eight times faster.
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"


# --- Auth -------------------------------------------------------------------
# Must be the real public origin. Auth callbacks break silently if it is stale,
# so update it after attaching the custom domain and redeploy.
NEXTAUTH_URL="https://YOURDOMAIN.com"

# Generate fresh, never reuse the development value:
#     openssl rand -base64 32
NEXTAUTH_SECRET=""

# The single admin account. It can read every customer's name, phone number and
# delivery address, so this needs to be a strong, unique password that exists
# nowhere else. After setting it, run the seed once to apply it.
ADMIN_EMAIL="admin@YOURDOMAIN.com"
ADMIN_PASSWORD=""


# --- Public origin ----------------------------------------------------------
# Used for absolute URLs in robots.txt and sitemap.xml. NEXT_PUBLIC_* values are
# inlined at build time, so changing this needs a redeploy, not a restart.
NEXT_PUBLIC_SITE_URL="https://YOURDOMAIN.com"


# --- Images (Cloudinary, free tier) ----------------------------------------
# From the Cloudinary dashboard. Without these the admin panel reports image
# upload as unconfigured and disables it; the storefront still works.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# --- Email (Resend, free tier) ---------------------------------------------
# Verify the domain in Resend first; EMAIL_FROM must be an address on it, or
# delivery fails. Free tier: 3,000/month, 100/day.
RESEND_API_KEY=""
EMAIL_FROM="NexVive <orders@YOURDOMAIN.com>"


# --- SMS / OTP --------------------------------------------------------------
# Customer login is phone + OTP, so without a gateway customer login is
# DISABLED in production. (It fails closed on purpose: the development
# fallback returns the code to the caller, which in production would let
# anyone log in as any phone number.) Guest checkout still works.
#
# Option A — Bangladesh gateway (cheaper for BD numbers, ~0.18–0.30 BDT/SMS):
SMS_API_URL=""          # e.g. http://bulksmsbd.net/api/smsapi
SMS_API_KEY=""
SMS_SENDER_ID=""        # the sender ID approved by the gateway

# Option B — Twilio (global; trial credit runs out):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""


# --- Optional ---------------------------------------------------------------
# Tawk.to live chat, format "<propertyId>/<widgetId>". Omit to disable.
NEXT_PUBLIC_TAWK_ID=""
